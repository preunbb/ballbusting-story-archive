#!/usr/bin/env bash
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
source "$repo_root/.githooks/lib/check-pushed-authors.sh"
upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
if [[ -n "$upstream" ]]; then
  check_range "$upstream..HEAD"
else
  check_range "HEAD"
fi